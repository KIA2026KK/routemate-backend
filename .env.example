DB_HOST=localhost
DB_PORT=5432
DB_NAME=routemate
DB_USER=routemate
DB_PASSWORD=
# Render internal PostgreSQL: require. Local Docker default: prefer.
DB_SSL_MODE=prefer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional Render environment variable (set only when using a URL; do not set an empty value):
# SPRING_DATA_REDIS_URL=rediss://user:password@host:port
SERVER_PORT=8080
# Render supplies PORT automatically; leave it unset for local SERVER_PORT usage.
# 개발 서버에서 합성 VIN 테스트를 허용할 때만 true
ALLOW_MOCK_VEHICLE=false
# LiveKit server credentials stay on the backend. Use wss for deployment.
LIVEKIT_SERVER_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
